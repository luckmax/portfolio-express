<%- include('partials/header.ejs') %>
<%- include('partials/main_nav.ejs') %>

<main class="container mt-4">
  <!-- Home page introduction -->
  <section class="hero">
    <div class="row align-items-center">
      <div class="col-md-4 mb-3">
        <figure class="profile-photo">
          <img src="/Assets/images/profile.png" alt="Portrait of Temesgen Teklebrhan">
          <figcaption>Temesgen Teklebrhan</figcaption>
        </figure>
      </div>
      <div class="col-md-8">
        <h1>Hi, I'm Temesgen.</h1>
        <h2 class="h4"><i class="fa-solid fa-shield-halved"></i> Networking and IT Security Student</h2>
        <p>
          I'm a second-year Networking and IT Security student at Ontario Tech University
          with a strong interest in cybersecurity, networking, and protecting digital systems.
        </p>
        <p>
          Through my studies, I've gained hands-on experience with Cisco Packet Tracer and I'm
