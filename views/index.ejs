    </div>
    <div class="col-md-4">
      <section class="quick-link">
        <h2 class="h5"><i class="fa-solid fa-network-wired"></i> My Projects</h2>
        <p>Networking, cybersecurity, and hands-on projects I have worked on.</p>
        <a href="/projects" class="my-button">View Projects</a>
      </section>
    </div>
    <div class="col-md-4">
      <section class="quick-link">
        <h2 class="h5"><i class="fa-solid fa-envelope"></i> Contact Me</h2>
        <p>Have a question or an opportunity? Send me a message.</p>
        <a href="/contactme" class="my-button">Get in Touch</a>
      </section>
    </div>
  </div>
</main>

